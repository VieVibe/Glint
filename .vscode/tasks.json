{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Glint: build",
      "type": "shell",
      "command": "powershell",
      "args": ["-NoProfile", "-File", "${workspaceFolder}/scripts/dev.ps1", "build"],
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": "$msCompile"
    },
    {
      "label": "Glint: run",
      "type": "shell",
      "command": "powershell",
      "args": ["-NoProfile", "-File", "${workspaceFolder}/scripts/dev.ps1", "run"],
      "problemMatcher": "$msCompile"
    }
  ]
}
