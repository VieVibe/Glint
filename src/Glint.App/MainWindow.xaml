<Window x:Class="Glint.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="轻启 Glint" Icon="Assets/glint.ico" Width="636" Height="630"
        WindowStyle="None" ResizeMode="NoResize"
        Background="#FAFBF8" ShowInTaskbar="True" Topmost="True"
        FontFamily="Microsoft YaHei UI" FontSize="13"
        PreviewKeyDown="OnPreviewKeyDown" Deactivated="OnDeactivated">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="0" GlassFrameThickness="0" CornerRadius="16" UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>
    <Window.Resources>
        <SolidColorBrush x:Key="Ink" Color="#222D28" />
        <ContextMenu x:Key="ResultMenu" Closed="OnResultMenuClosed">
            <MenuItem Header="固定到常用" Click="OnPinClick" InputGestureText="Ctrl+D" />
            <MenuItem Header="编辑搜索别名…" Click="OnEditAliasesClick" InputGestureText="Ctrl+E" />
        </ContextMenu>
        <Style TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#65736C" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}" CornerRadius="7" Padding="{TemplateBinding Padding}">
                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ButtonBorder" Property="Background" Value="#E6ECE6" /></Trigger>
                    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="ButtonBorder" Property="Background" Value="#E6ECE6" /></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
    </Window.Resources>
    <Border Background="#FAFBF8" BorderBrush="#D8E1D9" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="52" /><RowDefinition Height="70" /><RowDefinition Height="42" />
                <RowDefinition Height="*" /><RowDefinition Height="Auto" /><RowDefinition Height="44" />
            </Grid.RowDefinitions>
            <Grid Margin="24,8,16,0" MouseLeftButtonDown="OnHeaderDrag">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Width="22" Height="22" Source="Assets/glint.png" Margin="0,0,9,0" RenderOptions.BitmapScalingMode="HighQuality" AutomationProperties.Name="Glint 图标" />
                    <TextBlock Text="Glint" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource Ink}" VerticalAlignment="Center" />
                    <TextBlock Text=" / 轻启" Foreground="#89958D" Margin="5,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="SettingsButton" Content="设置" Click="OnSettingsClick" ToolTip="设置 (F2)" AutomationProperties.Name="设置">
                        <Button.ContextMenu>
                            <ContextMenu x:Name="SettingsMenu" Closed="OnSettingsClosed">
                                <MenuItem Header="刷新应用列表" Click="OnRefreshClick" />
                                <MenuItem Header="添加便携应用…" Click="OnAddPortableClick" />
                                <MenuItem x:Name="PortableMenu" Header="移除手动添加的应用" />
                                <Separator />
                                <MenuItem Header="唤出快捷键">
                                    <MenuItem x:Name="AltSpaceMenu" Header="Alt+Space" IsCheckable="True" Click="OnAltSpaceClick" />
                                    <MenuItem x:Name="CtrlAltSpaceMenu" Header="Ctrl+Alt+Space" IsCheckable="True" Click="OnCtrlAltSpaceClick" />
                                </MenuItem>
                                <MenuItem x:Name="StartupMenu" Header="开机启动" IsCheckable="True" Click="OnStartupClick" />
                                <Separator />
                                <MenuItem Header="作者 GitHub · VieVibe" Click="OnAuthorGitHubClick" ToolTip="https://github.com/VieVibe" />
                                <MenuItem Header="项目主页与反馈" Click="OnProjectGitHubClick" ToolTip="https://github.com/VieVibe/Glint" />
                                <Separator />
                                <MenuItem Header="退出轻启" Click="OnExitClick" />
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                    <Button Content="Esc" Margin="3,0,0,0" ToolTip="收起到托盘" Click="OnHideClick" AutomationProperties.Name="收起" />
                </StackPanel>
            </Grid>
            <Border Grid.Row="1" Margin="20,8,20,0" Background="White" BorderBrush="#CFDCD1" BorderThickness="1" CornerRadius="12">
                <Grid Margin="16,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="28" /><ColumnDefinition Width="*" /><ColumnDefinition Width="32" /></Grid.ColumnDefinitions>
                    <Viewbox Width="19" Height="19" HorizontalAlignment="Left"><Path Stroke="#55715F" StrokeThickness="1.6" Data="M 14,8 A 6,6 0 1 1 2,8 A 6,6 0 1 1 14,8 M 12.5,12.5 L 18,18" /></Viewbox>
                    <TextBox x:Name="SearchBox" Grid.Column="1" FontSize="20" Foreground="{StaticResource Ink}" BorderThickness="0" Background="Transparent"
                             VerticalContentAlignment="Center" Padding="4,0" TextChanged="OnSearchChanged" AutomationProperties.Name="搜索应用" />
                    <TextBlock Grid.Column="1" Text="搜索应用，随即出发" FontSize="19" Foreground="#A0AAA1" Margin="6,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False">
                        <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value=""><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                    </TextBlock>
                    <Button Grid.Column="2" Content="×" FontSize="20" Padding="4" Click="OnClearClick" ToolTip="清空搜索" AutomationProperties.Name="清空搜索" />
                </Grid>
            </Border>
            <Grid Grid.Row="2" Margin="26,0,26,0">
                <TextBlock x:Name="SectionLabel" Text="常用应用" Foreground="#748176" VerticalAlignment="Center" />
                <TextBlock x:Name="CountLabel" Text="正在收集应用…" Foreground="#89958D" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="11" />
            </Grid>
            <Grid Grid.Row="3" Margin="14,0">
                <ListBox x:Name="ResultsList" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Auto" HorizontalContentAlignment="Stretch" SelectionMode="Single"
                         ToolTip="右键或 Ctrl+D 固定应用；Ctrl+E 编辑搜索别名"
                         PreviewMouseLeftButtonUp="OnResultClick" AutomationProperties.Name="应用搜索结果">
                    <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="0" /><Setter Property="Margin" Value="0,1" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="AutomationProperties.Name" Value="{Binding Name}" />
                        <Setter Property="ContextMenu" Value="{StaticResource ResultMenu}" />
                        <EventSetter Event="ContextMenuOpening" Handler="OnResultMenuOpening" />
                        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
                            <Border x:Name="Row" CornerRadius="10" Padding="12,9" Background="Transparent"><ContentPresenter /></Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Row" Property="Background" Value="#EDF1EA" /></Trigger>
                                <Trigger Property="IsSelected" Value="True"><Setter TargetName="Row" Property="Background" Value="#E1EBDE" /></Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate></Setter.Value></Setter>
                    </Style></ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate><DataTemplate>
                        <Grid Height="34">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="44" /><ColumnDefinition Width="*" /><ColumnDefinition Width="50" /></Grid.ColumnDefinitions>
                            <Border Width="32" Height="32" CornerRadius="8" Background="#F1F3ED" HorizontalAlignment="Left">
                                <Grid>
                                    <TextBlock Text="{Binding Initial}" Foreground="#53705B" FontSize="17" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    <Image Source="{Binding Icon}" Width="28" Height="28" />
                                </Grid>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding PinIndicator}" Foreground="#52744E" Margin="0,0,4,0" FontSize="12" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="14" Foreground="{StaticResource Ink}" TextTrimming="CharacterEllipsis" />
                                </Grid>
                                <TextBlock Text="{Binding Source}" FontSize="10" Foreground="#819080" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <TextBlock Grid.Column="2" Text="{Binding Shortcut}" FontSize="11" Foreground="#7B8C7D" HorizontalAlignment="Right" VerticalAlignment="Center" />
                        </Grid>
                    </DataTemplate></ListBox.ItemTemplate>
                </ListBox>
                <StackPanel x:Name="EmptyState" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Collapsed" Margin="20">
                    <TextBlock x:Name="EmptyTitle" Text="没有找到应用" FontSize="19" Foreground="#526955" HorizontalAlignment="Center" />
                    <TextBlock x:Name="EmptyHint" Text="换个名称，或在设置中添加便携应用" Margin="0,12,0,0" Foreground="#8A978A" TextWrapping="Wrap" TextAlignment="Center" />
                </StackPanel>
            </Grid>
            <TextBlock x:Name="Notice" Grid.Row="4" Margin="26,8" Foreground="#8B5A24" FontSize="12" TextWrapping="Wrap" Visibility="Collapsed" />
            <Border Grid.Row="5" BorderBrush="#E5EAE1" BorderThickness="0,1,0,0" Margin="20,0">
                <Grid Margin="6,0">
                    <TextBlock Text="↑↓ 选择    ↵ 打开    Alt+数字 直达" FontSize="11" Foreground="#819080" VerticalAlignment="Center" />
                    <TextBlock x:Name="HotkeyLabel" Text="Alt+Space 唤出" FontSize="11" Foreground="#819080" VerticalAlignment="Center" HorizontalAlignment="Right" />
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
