<Window x:Class="Glint.App.AliasEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="搜索别名" Width="470" Height="310" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Background="#FAFBF8"
        FontFamily="Microsoft YaHei UI" PreviewKeyDown="OnPreviewKeyDown">
    <Grid Margin="24">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <TextBlock x:Name="AppName" FontSize="18" FontWeight="SemiBold" Foreground="#315E45" TextTrimming="CharacterEllipsis" />
        <TextBlock Grid.Row="1" Text="给它起几个好记的名字，用逗号或换行分隔。" Foreground="#738174" Margin="0,10,0,12" />
        <TextBox x:Name="AliasesBox" Grid.Row="2" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                 Padding="10" BorderBrush="#CFDCD1" Background="White" FontSize="14" MaxLength="1024" AutomationProperties.Name="搜索别名" />
        <TextBlock x:Name="ValidationMessage" Grid.Row="3" Foreground="#8B5A24" TextWrapping="Wrap" Margin="0,8,0,0" />
        <Grid Grid.Row="4" Margin="0,14,0,0">
            <TextBlock Text="留空可清除别名 · Ctrl+Enter 保存" VerticalAlignment="Center" Foreground="#819080" FontSize="11" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="取消" IsCancel="True" Padding="15,6" Margin="0,0,8,0" />
                <Button Content="保存" Click="OnSaveClick" Padding="15,6" Background="#315E45" Foreground="White" BorderThickness="0" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
