<Window x:Class="Glint.App.PreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="快速预览 · 轻启 Glint" Icon="Assets/glint.ico"
        Width="960" Height="720" Background="#FAFBF8" Topmost="True" ShowActivated="True"
        FontFamily="Microsoft YaHei UI" FontSize="13"
        WindowStartupLocation="Manual" PreviewKeyDown="OnPreviewKeyDown"
        Loaded="OnLoaded" Closed="OnClosed" Deactivated="OnDeactivated">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="Margin" Value="4,0" />
            <Setter Property="Background" Value="#EDF1EA" />
            <Setter Property="Foreground" Value="#294833" />
            <Setter Property="BorderBrush" Value="#D2DDD2" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Border BorderBrush="#DCE4DA" BorderThickness="0,0,0,1" Padding="20,14">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock x:Name="FileNameLabel" FontSize="16" FontWeight="SemiBold" Foreground="#222D28" TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="DetailsLabel" Margin="0,5,0,0" Foreground="#738170" TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="默认应用打开" Click="OnOpenClick" ToolTip="使用默认应用打开 (Enter)" />
                    <Button Content="关闭" Click="OnCloseClick" ToolTip="关闭预览 (Space / Esc)" />
                </StackPanel>
            </Grid>
        </Border>
        <Grid x:Name="PreviewArea" Grid.Row="1" Background="#EFF2EC">
            <ScrollViewer x:Name="ImageScroll" Visibility="Collapsed" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                <Image x:Name="PreviewImage" Stretch="Uniform" Margin="16" RenderOptions.BitmapScalingMode="HighQuality"
                       MaxWidth="{Binding ActualWidth, ElementName=PreviewArea}" MaxHeight="{Binding ActualHeight, ElementName=PreviewArea}"
                       AutomationProperties.Name="文件预览图片" />
            </ScrollViewer>
            <TextBox x:Name="DocumentText" Visibility="Collapsed" IsReadOnly="True" AcceptsReturn="True" AcceptsTab="True"
                     FontFamily="Cascadia Mono, Consolas, Microsoft YaHei UI" FontSize="14" Padding="24"
                     Background="White" Foreground="#222D28" BorderThickness="0" TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" AutomationProperties.Name="文档预览内容" />
            <MediaElement x:Name="Video" Visibility="Collapsed" LoadedBehavior="Manual" UnloadedBehavior="Manual"
                          Stretch="Uniform" MediaOpened="OnMediaOpened" MediaEnded="OnMediaEnded" MediaFailed="OnMediaFailed" />
            <StackPanel x:Name="MessagePanel" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="32" MaxWidth="580">
                <TextBlock x:Name="MessageTitle" Text="正在读取…" TextAlignment="Center" FontSize="22" Foreground="#415942" TextWrapping="Wrap" />
                <TextBlock x:Name="MessageHint" Margin="0,14,0,0" TextAlignment="Center" Foreground="#738170" TextWrapping="Wrap" />
            </StackPanel>
        </Grid>
        <Border Grid.Row="2" Padding="16,10" BorderBrush="#DCE4DA" BorderThickness="0,1,0,0">
            <StackPanel>
                <StackPanel x:Name="PdfControls" Orientation="Horizontal" HorizontalAlignment="Center" Visibility="Collapsed" Margin="0,0,0,8">
                    <Button x:Name="PreviousPage" Content="上一页" Click="OnPreviousPage" />
                    <TextBlock x:Name="PageLabel" VerticalAlignment="Center" Margin="12,0" Foreground="#52694E" />
                    <Button x:Name="NextPage" Content="下一页" Click="OnNextPage" />
                </StackPanel>
                <Grid x:Name="VideoControls" Visibility="Collapsed" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <Button x:Name="PlayPause" Content="暂停" Click="OnPlayPause" />
                    <Slider x:Name="VideoPosition" Grid.Column="1" Margin="12,0" Minimum="0" Maximum="1" VerticalAlignment="Center"
                            PreviewMouseLeftButtonDown="OnSeekStart" PreviewMouseLeftButtonUp="OnSeekEnd" ValueChanged="OnPositionChanged"
                            AutomationProperties.Name="视频进度" />
                    <TextBlock x:Name="TimeLabel" Grid.Column="2" VerticalAlignment="Center" Foreground="#52694E" />
                </Grid>
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <TextBlock x:Name="StatusLabel" Foreground="#738170" TextTrimming="CharacterEllipsis" Margin="0,0,16,0" />
                    <TextBlock Grid.Column="1" Text="Space / Esc 关闭 · Enter 打开" Foreground="#738170" FontSize="11" VerticalAlignment="Center" />
                </Grid>
            </StackPanel>
        </Border>
    </Grid>
</Window>
