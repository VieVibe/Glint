<Window x:Class="Glint.App.PreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:edit="http://icsharpcode.net/sharpdevelop/avalonedit"
        Title="快速预览 · 轻启 Glint" Icon="Assets/glint.ico"
        Width="960" Height="720" MinWidth="460" MinHeight="300"
        WindowStyle="None" ResizeMode="CanResize" WindowStartupLocation="Manual"
        Background="#F7F9F5" Topmost="True" ShowActivated="True"
        FontFamily="Microsoft YaHei UI" FontSize="13" UseLayoutRounding="True"
        PreviewKeyDown="OnPreviewKeyDown" PreviewMouseWheel="OnPreviewMouseWheel"
        Loaded="OnLoaded" Closed="OnClosed" Deactivated="OnDeactivated">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="64" ResizeBorderThickness="6" GlassFrameThickness="0"
                            CornerRadius="12" UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>
    <Window.Resources>
        <SolidColorBrush x:Key="Ink" Color="#203129" />
        <SolidColorBrush x:Key="Muted" Color="#52655B" />
        <SolidColorBrush x:Key="Frame" Color="#D7E1D8" />
        <Style x:Key="ActionButton" TargetType="ButtonBase">
            <Setter Property="Padding" Value="11,6" />
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource Ink}" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ButtonBase">
                        <Border x:Name="Surface" CornerRadius="7" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="#E6EFE7" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="#D9E8DC" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Surface" Property="BorderBrush" Value="#5A8068" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Surface" Property="Opacity" Value=".4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="Button" BasedOn="{StaticResource ActionButton}" />
        <Style TargetType="ToggleButton" BasedOn="{StaticResource ActionButton}">
            <Style.Triggers>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="Background" Value="#DFEBE1" />
                    <Setter Property="BorderBrush" Value="#B8CCBC" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="Keycap" TargetType="Border">
            <Setter Property="Padding" Value="5,1" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Background" Value="#EEF3EE" />
        </Style>
    </Window.Resources>
    <Border Background="{Binding Background, RelativeSource={RelativeSource AncestorType=Window}}"
            BorderBrush="{StaticResource Frame}" BorderThickness="1" CornerRadius="12">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="68" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid Margin="18,0,12,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border MinWidth="44" Height="40" Padding="7,0" CornerRadius="9" Background="#E3EDE4" VerticalAlignment="Center">
                    <TextBlock x:Name="FileTypeLabel" MaxWidth="68" TextTrimming="CharacterEllipsis"
                               FontSize="11" FontWeight="SemiBold" Foreground="#355746" VerticalAlignment="Center" HorizontalAlignment="Center" />
                </Border>
                <StackPanel Grid.Column="1" Margin="12,0,12,0" VerticalAlignment="Center">
                    <TextBlock x:Name="FileNameLabel" FontSize="17" FontWeight="SemiBold"
                               Foreground="{StaticResource Ink}" TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="DetailsLabel" Margin="0,4,0,0" FontSize="11"
                               Foreground="{StaticResource Muted}" TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <ToggleButton x:Name="WrapButton" Content="换行" Visibility="Collapsed" Margin="0,0,6,0" ToolTip="自动换行 (Ctrl+W)"
                                  AutomationProperties.Name="自动换行 (Ctrl+W)" />
                    <Button Background="#E3EDE4" Foreground="#214D37" Click="OnOpenClick" ToolTip="使用默认应用打开 (Enter)"
                            AutomationProperties.Name="用默认应用打开">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="打开" VerticalAlignment="Center" />
                            <Path Data="M 1,8 L 8,1 M 3,1 L 8,1 L 8,6" Width="10" Height="10" Margin="7,0,0,0"
                                  VerticalAlignment="Center" StrokeThickness="1.2" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="CloseButton" Margin="6,0,0,0" Width="32" Padding="0" Click="OnCloseClick"
                            ToolTip="关闭预览 (Space / Esc)" AutomationProperties.Name="关闭预览">
                        <Path Data="M 1,1 L 11,11 M 11,1 L 1,11" Width="12" Height="12" StrokeThickness="1.3" Stroke="{StaticResource Muted}" />
                    </Button>
                </StackPanel>
            </Grid>
            <Border Grid.Row="1" Margin="12,0" Background="#EAF0EA" BorderBrush="{StaticResource Frame}" BorderThickness="1"
                    CornerRadius="9" ClipToBounds="True">
                <Grid Margin="1">
                    <Grid x:Name="VisualSurface" Visibility="Collapsed" Margin="14" SizeChanged="OnVisualSizeChanged">
                        <ScrollViewer x:Name="VisualScroll" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                                      HorizontalContentAlignment="Center" VerticalContentAlignment="Center">
                            <Grid x:Name="VisualContent">
                                <Image x:Name="PreviewImage" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"
                                       AutomationProperties.Name="文件预览图片" />
                                <MediaElement x:Name="Video" Visibility="Collapsed" LoadedBehavior="Manual" UnloadedBehavior="Manual"
                                              Stretch="Uniform" MediaOpened="OnMediaOpened" MediaEnded="OnMediaEnded" MediaFailed="OnMediaFailed" />
                            </Grid>
                        </ScrollViewer>
                    </Grid>
                    <Border x:Name="DocumentSurface" Visibility="Collapsed" Background="#FCFDFB" CornerRadius="7" Padding="13,10,5,5">
                        <edit:TextEditor x:Name="DocumentText" IsReadOnly="True" Foreground="{StaticResource Ink}"
                                         Background="Transparent" LineNumbersForeground="#66796E" BorderThickness="0"
                                         FontFamily="Cascadia Mono, Consolas, Microsoft YaHei UI" FontSize="14"
                                         WordWrap="{Binding IsChecked, ElementName=WrapButton}"
                                         HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                                         AutomationProperties.Name="文档预览内容" />
                    </Border>
                    <StackPanel x:Name="MessagePanel" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="30" MaxWidth="500">
                        <Border Width="52" Height="52" Background="#DCE9DE" CornerRadius="14" Margin="0,0,0,16">
                            <Path Data="M 2,1 L 12,1 L 17,6 L 17,21 L 2,21 Z M 12,1 L 12,6 L 17,6 M 6,11 L 13,11 M 6,15 L 13,15"
                                  Width="19" Height="23" StrokeThickness="1.4" Stroke="#4B6E56" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock x:Name="MessageTitle" Text="正在读取…" TextAlignment="Center" FontSize="18" FontWeight="SemiBold"
                                   Foreground="{StaticResource Ink}" TextWrapping="Wrap" />
                        <TextBlock x:Name="MessageHint" Margin="0,8,0,0" TextAlignment="Center" Foreground="{StaticResource Muted}" TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>
            </Border>
            <StackPanel Grid.Row="2" Margin="18,4,18,0">
                <StackPanel x:Name="PdfControls" Orientation="Horizontal" HorizontalAlignment="Center" Visibility="Collapsed" Margin="0,4,0,0">
                    <Button x:Name="PreviousPage" Content="‹  上一页" Click="OnPreviousPage" />
                    <TextBlock x:Name="PageLabel" VerticalAlignment="Center" Margin="12,0" Foreground="{StaticResource Muted}" />
                    <Button x:Name="NextPage" Content="下一页  ›" Click="OnNextPage" />
                </StackPanel>
                <Grid x:Name="VideoControls" Visibility="Collapsed" Margin="0,4,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <Button x:Name="PlayPause" Content="暂停" Click="OnPlayPause" />
                    <Slider x:Name="VideoPosition" Grid.Column="1" Margin="12,0" Minimum="0" Maximum="1" VerticalAlignment="Center"
                            PreviewMouseLeftButtonDown="OnSeekStart" PreviewMouseLeftButtonUp="OnSeekEnd" ValueChanged="OnPositionChanged"
                            AutomationProperties.Name="视频进度" />
                    <TextBlock x:Name="TimeLabel" Grid.Column="2" VerticalAlignment="Center" Foreground="{StaticResource Muted}" />
                </Grid>
                <Grid Height="36" TextElement.Foreground="{StaticResource Muted}" TextElement.FontSize="11">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <TextBlock x:Name="StatusLabel" TextTrimming="CharacterEllipsis" Margin="0,0,14,0" VerticalAlignment="Center" />
                    <StackPanel x:Name="ZoomControls" Grid.Column="1" Orientation="Horizontal" Visibility="Collapsed"
                                Margin="0,0,14,0" VerticalAlignment="Center">
                        <Button x:Name="ZoomOut" Content="−" Width="26" Padding="0" Click="OnZoomOut"
                                ToolTip="缩小" AutomationProperties.Name="缩小预览" />
                        <Button x:Name="ResetZoom" Content="100%" MinWidth="47" Padding="4,0" Click="OnResetZoom"
                                ToolTip="滚轮缩放 · Shift + 滚轮滚动 · 点击恢复 100%"
                                AutomationProperties.HelpText="滚轮缩放，Shift 加滚轮滚动，点击恢复 100%" />
                        <Button x:Name="ZoomIn" Content="+" Width="26" Padding="0" Click="OnZoomIn"
                                ToolTip="放大" AutomationProperties.Name="放大预览" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Style="{StaticResource Keycap}"><TextBlock Text="Space" /></Border>
                        <Border Style="{StaticResource Keycap}" Margin="3,0,0,0"><TextBlock Text="Esc" /></Border>
                        <TextBlock Text="关闭" Margin="5,0,14,0" VerticalAlignment="Center" />
                        <Border Style="{StaticResource Keycap}"><TextBlock Text="Enter" /></Border>
                        <TextBlock Text="打开" Margin="5,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Grid>
    </Border>
</Window>
