<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>disable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\glint.ico</ApplicationIcon>
    <!-- WPF owns startup and DPI; WinForms is used only for the tray and screen information. -->
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
    <AssemblyName>Glint</AssemblyName>
    <Version>0.3.1</Version>
    <RootNamespace>Glint.App</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Glint.Checks" />
    <Resource Include="Assets\glint.ico" />
    <Resource Include="Assets\glint.png" />
    <EmbeddedResource Include="Assets\Preview*.xshd" />
    <PackageReference Include="AvalonEdit" Version="6.3.1.120" />
    <PackageReference Include="Markdig" Version="1.6.0" />
    <ProjectReference Include="..\Glint.Core\Glint.Core.csproj" />
    <Content Include="..\..\LICENSE" Link="LICENSE" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\THIRD-PARTY-NOTICES.md" Link="THIRD-PARTY-NOTICES.md" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\README.md" Link="README.md" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\licenses\**\*" Link="licenses\%(RecursiveDir)%(Filename)%(Extension)" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
